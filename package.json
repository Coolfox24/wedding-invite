{
  "name": "wedding-invite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "api:dev": "node --experimental-strip-types --watch server/index.ts",
    "api:build": "tsc -p tsconfig.server.json",
    "api:start": "node dist-server/index.js",
    "api:test": "node --experimental-strip-types --test server/api.test.ts",
    "rsvp:check": "tsc -p tsconfig.rsvp-test.json",
    "rsvp:test": "node --experimental-strip-types --test tests/rsvp.test.ts",
    "api:admin": "node --experimental-strip-types server/cli.ts"
  },
  "dependencies": {
    "framer-motion": "^13.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  }
}
