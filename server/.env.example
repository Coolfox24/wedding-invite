# Apply these environment variables before starting the API. No secrets belong here.
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=./data/rsvp.sqlite
ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173/wedding-invite/
TRUST_CLOUDFLARE_PROXY=false
RATE_LIMIT_PER_IP=120
RATE_LIMIT_PER_INVITE=30
# Optional: end of the displayed RSVP deadline, in Sydney daylight saving time.
# RSVP_CLOSES_AT=2026-12-11T23:59:59+11:00
# Optional: serve a separately built frontend from this directory.
# STATIC_DIRECTORY=./dist
